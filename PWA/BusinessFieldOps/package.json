{
  "name": "businessfieldops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "icons": "node ./generate-icons.js",
    "build": "tsc && vite build",
    "deploy": "node ./generate-icons.js --only-pwa && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy cookie preferredLanguage baseLocale",
    "preview": "vite preview",
    "tauri": "tauri",
    "translations": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy cookie preferredLanguage baseLocale",
    "clean": "gts clean",
    "compile": "tsc",
    "lint": "eslint . --max-warnings 0",
    "fix": "eslint . --fix",
    "prepare": "node ./generate-icons.js --only-pwa && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy cookie preferredLanguage baseLocale",
    "pretest": "tsc",
    "posttest": "pnpm run lint",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@material-design-icons/font": "^0.14.15",
    "@supabase/supabase-js": "^2.117.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "dexie": "^4.4.6",
    "mdui": "^2.1.5",
    "preact": "^10.29.8",
    "preact-router": "^4.1.2",
    "wouter-preact": "^3.13.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "8.0.0-rc.6",
    "@eslint/css": "^2.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.4.2",
    "@inlang/paraglide-js": "^2.27.0",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-preact": "^2.0.0",
    "globals": "^17.13.0",
    "gts": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}