{
  "name": "businessfieldops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "dev": "vite",
    "icons": "node ./generate-icons.js",
    "build": "tsc && vite build",
    "deploy": "node ./generate-icons.js --only-pwa && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "preview": "vite preview",
    "tauri": "tauri",
    "translations" : "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "node ./generate-icons.js --only-pwa && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "pretest": "tsc",
    "posttest": "pnpm run lint",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@babel/eslint-parser": "8.0.0-rc.6",
    "@material-design-icons/font": "^0.14.15",
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "eslint-config-preact": "^2.0.0",
    "gts": "^7.0.0",
    "mdui": "^2.1.5",
    "preact": "^10.29.8",
    "preact-router": "^4.1.2",
    "wouter-preact": "^3.11.1"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.3.7",
    "@inlang/paraglide-js": "^2.25.4",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "gts": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
